#!/home/marwan/.venv/bin/python3
import sys
import os
from rag_engine import RAGEngine

def main():
    if len(sys.argv) < 2:
        print("Usage: ./index_pdf <path_to_pdf>")
        sys.exit(1)

    pdf_path = sys.argv[1]
    engine = RAGEngine()
    print(f"Indexing '{pdf_path}'...")
    res = engine.index_pdf(pdf_path)
    if res.get("status") == "success":
        print(f"\033[92m[SUCCESS]\033[0m Indexed '{res['filename']}': {res['pages']} pages, {res['chunks']} chunks.")
    else:
        print(f"\033[91m[ERROR]\033[0m {res.get('message')}")

if __name__ == "__main__":
    main()
